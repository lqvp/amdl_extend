# Spike-only verification image for the wrapper-lite-rootless child-process probe.
#
# NOT the amd-hub runtime image.  Task 2 writes that one.  This exists so the
# container half of the finding in
# docs/superpowers/findings/2026-09-26-wrapper-child-process-spike.md
# is reproducible from the repository instead of from /tmp.
#
# Build (from the workspace root, so the .dockerignore at the root applies and
# keeps the NDK, the build tree and rootfs/data out of the context):
#
#   docker build -f hub/spike/Dockerfile.probe -t amd-hub-spike:probe .
#
# Run (the configuration the finding calls "works"):
#
#   docker run --rm --security-opt seccomp=unconfined \
#     --security-opt systempaths=unconfined \
#     -w /w/hub amd-hub-spike:probe \
#     uv run python spike/child_process_probe.py \
#     --binary /w/wrapper-lite-rootless --port 0
#
# Two properties this image deliberately has, because the finding turns on them:
#
#  * The rootfs is COPYed in, so it is owned by root in the image.  The launcher
#    unshare(CLONE_NEWUSER)s with a single-uid map ("0 0 1") before touching the
#    filesystem, so a rootfs owned by any other uid becomes unwritable.  A
#    bind-mounted host tree does not reproduce the deployment and fails for the
#    wrong reason -- see the finding, section 5.1.
#  * The launcher sits next to the rootfs in /w, because the chroot target is
#    "./rootfs" relative to the CWD, not an argument.
FROM python:3.13-slim

# uv, so the container run can use the same `uv run python ...` shape as the
# brief.  Without it `docker run ... python` makes the probe PID 1, and the
# brief's own "getppid() != 0" clause then fails for a reason that has nothing
# to do with the launcher.
RUN pip install --no-cache-dir uv==0.12.9

WORKDIR /w
COPY wrapper/wrapper-lite-rootless /w/wrapper-lite-rootless
COPY wrapper/rootfs /w/rootfs
COPY hub/spike /w/hub/spike
RUN chmod +x /w/wrapper-lite-rootless
